<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <Version>$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd.HH'))</Version>
        <Company>Modulefabrique</Company>
        <Copyright>Copyright © Modulefabrique $([System.DateTime]::Now.Year)</Copyright>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <ImplicitUsings>true</ImplicitUsings>
        <PublishAddinFiles>true</PublishAddinFiles>
        <Configurations>Debug R24;Debug R26</Configurations>
        <Configurations>$(Configurations);Release R24;Release R26</Configurations>
    </PropertyGroup>
    
    <PropertyGroup Condition="$(Configuration.Contains('R24'))">
        <RevitVersion>2024</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>$(DefineConstants);REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
        <OutputPath>bin\$(Configuration.Split(' ')[0])\$(RevitVersion)\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
        <RevitVersion>2026</RevitVersion>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <DefineConstants>$(DefineConstants);REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
        <OutputPath>bin\$(Configuration.Split(' ')[0])\$(RevitVersion)\</OutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
        <StartArguments>/language ENG</StartArguments>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="2.*" />
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
		<PackageReference Include="RevitMCPSDK" Version="$(RevitVersion).*" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="System.Net.Http" />
    </ItemGroup>

    <!-- MF_Utilities (ParameterHelper e.a.) - eigen add-in van Modulefabrique, geen NuGet-package en
         geen ProjectReference (aparte solution/repo). Gerefereerd vanaf de netwerkmap waar de
         Release-build van Modulefabrique_Addin al staat (dezelfde map als RevitMCPPlugin.dll, zie
         CopyToNetworkAddinFolder in RevitMCPPlugin.csproj) - dus geen apart publicatiepad nodig.
         Private=false: we laten MSBuild NIET automatisch de dependencies van MF_Utilities.dll
         meekopiëren, want die map bevat ook een eigen Newtonsoft.Json.dll/RevitMCPSDK.dll die niet de
         hier via NuGet gebruikte versies mogen overschrijven. Zie CopyMFUtilitiesDependencies hieronder
         voor de expliciete, beperkte kopieerlijst van wat MF_Utilities wél nodig heeft. -->
    <PropertyGroup>
        <ModuleFabriqueAddinDir>O:\02 - Software\021 - Revit\0221 - API\AddinFiles\$(RevitVersion)\ModuleFabriqueAddin\</ModuleFabriqueAddinDir>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="MF_Utilities">
            <HintPath>$(ModuleFabriqueAddinDir)MF_Utilities.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Kopieert MF_Utilities.dll + de specifieke runtime-dependencies die het nodig heeft (Excel-/
         Office-interop, en op net8 System.Drawing.Common) naar $(TargetDir), zodat ze via de bestaande
         DeployCommandSet-target hieronder vanzelf meekomen naar Commands\Commandset\<RevitVersion>\ -
         waar CommandManager's AssemblyResolve-handler ze kan vinden naast RevitMCPCommandSet.dll. -->
    <Target Name="CopyMFUtilitiesDependencies" AfterTargets="Build" BeforeTargets="DeployCommandSet">
        <ItemGroup>
            <MFUtilitiesDependencies Include="$(ModuleFabriqueAddinDir)MF_Utilities.dll" />
            <MFUtilitiesDependencies Include="$(ModuleFabriqueAddinDir)office.dll" />
            <MFUtilitiesDependencies Include="$(ModuleFabriqueAddinDir)Microsoft.Office.Interop.Excel.dll" />
            <MFUtilitiesDependencies Include="$(ModuleFabriqueAddinDir)System.Drawing.Common.dll" Condition="$(Configuration.Contains('R26'))" />
        </ItemGroup>

        <Copy SourceFiles="@(MFUtilitiesDependencies)" DestinationFolder="$(TargetDir)" />
    </Target>

    <!-- Debug: lokale Commands-map. Release: netwerkschijf (NetworkRootPath\Commands, zie
         RevitMCPPlugin.dll.config). Beide hebben nu al dezelfde structuur:
         Commands\commandRegistry.json
         Commands\Commandset\command.json
         Commands\Commandset\<RevitVersion>\<dll's> -->
    <PropertyGroup Condition="$(Configuration.Contains('Debug'))">
        <CommandsRootDir>C:\Users\t.vwolferen\revit-mcp\Commands\</CommandsRootDir>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('Release'))">
        <CommandsRootDir>O:\02 - Software\021 - Revit\0221 - API\MCP\Commands\</CommandsRootDir>
    </PropertyGroup>

    <Target Name="DeployCommandSet" AfterTargets="Build">
        <PropertyGroup>
            <CommandsetDir>$(CommandsRootDir)Commandset\</CommandsetDir>
        </PropertyGroup>

        <ItemGroup>
            <CommandSetBinaries Include="$(TargetDir)*.dll" />
            <CommandSetBinaries Include="$(TargetDir)*.pdb" />
        </ItemGroup>

        <Copy SourceFiles="@(CommandSetBinaries)" DestinationFolder="$(CommandsetDir)$(RevitVersion)\" />

        <!-- .json-bestanden komen uit de repo (commandset/), zodat ze centraal vanuit git beheerd worden. -->
        <Copy SourceFiles="$(ProjectDir)command.json" DestinationFolder="$(CommandsetDir)" />
        <Copy SourceFiles="$(ProjectDir)commandRegistry.json" DestinationFolder="$(CommandsRootDir)" />
    </Target>

</Project>