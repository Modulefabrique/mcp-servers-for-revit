<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Als leeg of dit bestand niet aanwezig is: gebruikt de plugin de lokale map naast RevitMCPPlugin.dll. -->
    <add key="NetworkRootPath" value="O:\02 - Software\021 - Revit\0221 - API\MCP" />

    <!-- Gedeelde map met MCP-server tool-bestanden (.js). Wordt bij het opstarten van de plugin
         gespiegeld naar LocalMcpServerToolsPath: bestanden die hier staan worden lokaal
         gekopieerd/overschreven, bestanden die hier niet (meer) staan worden lokaal verwijderd
         (met uitzondering van register.js). Leeg laten om deze synchronisatie uit te schakelen. -->
    <add key="NetworkMcpToolsPath" value="O:\02 - Software\021 - Revit\0221 - API\MCP\Tools" />

    <!-- Lokaal pad naar de tools-map van de MCP-server op déze machine (server/build/tools).
         Dit verschilt per machine/installatie en moet dus per machine ingesteld worden. -->
    <add key="LocalMcpServerToolsPath" value="C:\Users\t.vwolferen\source\repos\mcp-servers-for-revit\server\build\tools" />
  </appSettings>
</configuration>
