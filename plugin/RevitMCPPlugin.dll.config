<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Als leeg of dit bestand niet aanwezig is: gebruikt de plugin de lokale map naast RevitMCPPlugin.dll. -->
    <add key="NetworkRootPath" value="O:\02 - Software\021 - Revit\0221 - API\MCP" />

    <!-- Gedeelde map met de volledige, gepubliceerde MCP-server build (index.js, register.js,
         utils/, tools/ - alles samen). Wordt bij het opstarten van de plugin volledig gespiegeld
         naar LocalMcpServerBuildPath: bestanden/submappen die hier staan worden lokaal
         gekopieerd/overschreven, bestanden/submappen die hier niet (meer) staan worden lokaal
         verwijderd (geen uitzonderingen meer - ook register.js wordt overschreven). Leeg laten
         om deze synchronisatie uit te schakelen. -->
    <add key="NetworkMcpServerBuildPath" value="O:\02 - Software\021 - Revit\0221 - API\MCP\Server\build" />

    <!-- Lokaal pad naar de build-map van de MCP-server op déze machine (server/build).
         Dit verschilt per machine/installatie en moet dus per machine ingesteld worden. -->
    <add key="LocalMcpServerBuildPath" value="C:\Users\t.vwolferen\revit-mcp\build" />
  </appSettings>
</configuration>
