<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>revit_mcp_plugin</RootNamespace>
        <Version>$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd.HH'))</Version>
        <AssemblyTitle>mcp-servers-for-revit-plugin</AssemblyTitle>
        <Product>mcp-servers-for-revit-plugin</Product>
        <Company>Modulefabrique</Company>
        <Copyright>Copyright © Modulefabrique $([System.DateTime]::Now.Year)</Copyright>
        <UseWindowsForms>true</UseWindowsForms>
        <UseWPF>true</UseWPF>
        <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
        <Configurations>Debug R24;Debug R26;Release R24;Release R26</Configurations>
        <PlatformTarget>x64</PlatformTarget>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('R24'))">
        <RevitVersion>2024</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <OutputPath>bin\$(Configuration.Split(' ')[0])\$(RevitVersion)\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
        <RevitVersion>2026</RevitVersion>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <OutputPath>bin\$(Configuration.Split(' ')[0])\$(RevitVersion)\</OutputPath>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>
    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
        <StartArguments>/language ENG</StartArguments>
    </PropertyGroup>
    <ItemGroup>
      <None Remove="Core\Resources\mcp-server-black-16.png" />
      <None Remove="Core\Resources\mcp-server-black-32.png" />
      <None Remove="Core\Resources\mcp-server-blue-16.png" />
      <None Remove="Core\Resources\mcp-server-blue-32.png" />
      <None Remove="Core\Resources\mcp-server-orange-16.png" />
      <None Remove="Core\Resources\mcp-server-orange-32.png" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
        <PackageReference Include="RevitMCPSDK" Version="$(RevitVersion).*" />
        <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Core\Resources\icon-16.png" />
        <EmbeddedResource Include="Core\Resources\icon-32.png" />
        <EmbeddedResource Include="Core\Resources\mcp-server-black-16.png" />
        <EmbeddedResource Include="Core\Resources\mcp-server-black-32.png" />
        <EmbeddedResource Include="Core\Resources\mcp-server-blue-16.png" />
        <EmbeddedResource Include="Core\Resources\mcp-server-blue-32.png" />
        <EmbeddedResource Include="Core\Resources\mcp-server-orange-16.png" />
        <EmbeddedResource Include="Core\Resources\mcp-server-orange-32.png" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Core\Resources\settings-16.png" />
        <EmbeddedResource Include="Core\Resources\settings-32.png" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
    <ItemGroup>
        <None Update="mcp-servers-for-revit.addin">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="RevitMCPPlugin.dll.config">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <!-- Debug: geen extra actie nodig, de build-output in bin\Debug\$(RevitVersion)\ is voldoende
         (de .addin en .dll.config landen daar al via de None Update-items hierboven). -->

    <!-- Release: kopieer de build-output naar de netwerkschijf waar ook de andere ModuleFabrique-
         addins vandaan komen, zonder het .addin-bestand (dat wordt daar los/anders beheerd). -->
    <Target Name="CopyToNetworkAddinFolder" AfterTargets="Build" Condition="$(Configuration.Contains('Release'))">
        <PropertyGroup>
            <NetworkAddinDir>O:\02 - Software\021 - Revit\0221 - API\AddinFiles\$(RevitVersion)\ModuleFabriqueAddin\</NetworkAddinDir>
        </PropertyGroup>

        <ItemGroup>
            <ReleaseFiles Include="$(TargetDir)*.dll" />
            <ReleaseFiles Include="$(TargetDir)*.pdb" />
            <ReleaseFiles Include="$(TargetDir)*.config" />
        </ItemGroup>

        <Copy SourceFiles="@(ReleaseFiles)" DestinationFolder="$(NetworkAddinDir)" />
    </Target>

</Project>